++"use worker";
++
++/*
++ * Witness Reaction Engine — JanitorAI Script
++ * v0.1.0
++ *
++ * Adds social atmosphere around punishment, violence, and tense public scenes.
++ * It changes the surrounding room/crowd response, not the character's intent
++ * or the mechanics of harming anyone.
++ *
++ * Narrative texture only. Avoids procedural guidance for harming or restraining
++ * a real person.
++ */
++
++context.character = context.character || {};
++context.character.scenario = context.character.scenario || "";
++
++const CONFIG = {
++  DEBUG: false,
++  HISTORY_DEPTH: 6,
++  MAX_BEATS: 4,
++  MAX_TOKENS: 170,
++  MIN_ACTIVATION: 4,
++  LATEST_BONUS: 4,
++  RECENT_BONUS: 1,
++  DIRECT_BONUS: 6,
++  REPETITION_PENALTY: 4
++};
++
++const REACTIONS = [
++  {
++    id:"crowd_silence",
++    tags:["crowd","sound"],
++    keys:["crowd","public","spectator","witness","market","courtyard","execution","punishment"],
++    line:"let nearby conversation thin out or stop for a moment, making the sudden quiet noticeable"
++  },
++  {
++    id:"look_away",
++    tags:["crowd","social"],
++    keys:["witness","crowd","spectator","public","punishment","violence","blood"],
++    line:"have one or two onlookers look away, busy themselves with a sleeve, or suddenly find the floor interesting"
++  },
++  {
++    id:"whisper_ripple",
++    tags:["crowd","sound"],
++    keys:["crowd","market","public","spectator","rumor","witness","court"],
++    line:"use a small ripple of whispers that dies down when someone important turns their head"
++  },
++  {
++    id:"guard_formality",
++    tags:["authority","social"],
++    keys:["guard","warden","soldier","prison","cell","court","punishment","execution"],
++    line:"make nearby authority figures become noticeably formal, clipped, or watchful without inventing a new motive"
++  },
++  {
++    id:"distance_opens",
++    tags:["crowd","space"],
++    keys:["crowd","public","market","courtyard","fight","violence","struggle"],
++    line:"let people subtly make more space around the tense scene, leaving an uneasy pocket of emptiness"
++  },
++  {
++    id:"bell_or_signal",
++    tags:["sound","authority"],
++    keys:["execution","punishment","court","castle","prison","public","ceremony"],
++    line:"use a bell, shouted signal, bootstep, or other institutional sound to punctuate the scene"
++  },
++  {
++    id:"ordinary_life",
++    tags:["contrast","place"],
++    keys:["street","market","courtyard","castle","public","crowd"],
++    line:"keep ordinary life moving at the edges—vendors, footsteps, weather, or chores continuing despite the tension"
++  },
++  {
++    id:"aftermath_glances",
++    tags:["aftermath","crowd"],
++    keys:["after","aftermath","released","escape","fight","struggle","punishment"],
++    line:"after the tense moment, let people exchange brief glances or quietly return to whatever they were doing"
++  },
++  {
++    id:"institutional_memory",
++    tags:["authority","aftermath"],
++    keys:["prison","warden","court","punishment","execution","castle","guard"],
++    line:"suggest that the place has routines around grim events through practiced movements, prepared spaces, or people who know when to stay silent"
++  },
++  {
++    id:"rumor_seed",
++    tags:["social","aftermath"],
++    keys:["rumor","market","crowd","public","witness","aftermath"],
++    line:"if the scene is public, leave room for conflicting whispers and half-understood versions of what just happened"
++  },
++  {
++    id:"weather_pressure",
++    tags:["place","contrast"],
++    keys:["courtyard","street","market","public","rain","snow","cold","storm"],
++    line:"use weather—rain on stone, cold wind, heat, or mud—to make the crowd's discomfort more tangible"
++  },
++  {
++    id:"empty_threshold",
++    tags:["space","tension"],
++    keys:["door","corridor","cell","prison","chamber","castle","dungeon"],
++    line:"make a doorway or corridor feel conspicuously empty, as though people nearby prefer not to linger"
++  }
++];
++
++const TRIGGERS = [
++  "punishment","execution","violence","fight","attack","brawl","prison",
++  "prisoner","guard","warden","court","crowd","spectator","witness",
++  "public","market","courtyard","cell","dungeon","interrogation",
++  "torture","stocks","pillory","gibbet","manacles","chains","aftermath"
++];
++
++function msg(m){ return ((m && m.message) ? m.message : String(m || "")).toLowerCase(); }
++function hits(text, arr){ let n=0; for(const x of arr) if(text.includes(x)) n++; return n; }
++function tokens(text){ return Math.ceil((text || "").length / 4); }
++
++const messages = context.chat.last_messages || [];
++const recent = messages
++  .slice(Math.max(0, messages.length - CONFIG.HISTORY_DEPTH))
++  .map(msg)
++  .join(" ");
++const latest = String(context.chat.last_message || "").toLowerCase();
++const activation = hits(latest, TRIGGERS) * 3 + hits(recent, TRIGGERS);
++
++if (activation >= CONFIG.MIN_ACTIVATION) {
++  const ranked = REACTIONS.map((reaction, i) => {
++    let score = hits(latest, reaction.keys) * CONFIG.LATEST_BONUS
++      + hits(recent, reaction.keys) * CONFIG.RECENT_BONUS;
++
++    if (reaction.keys.some(k => latest.includes(k))) score += CONFIG.DIRECT_BONUS;
++
++    const repeated = reaction.keys.some(k => recent.includes(k) && !latest.includes(k));
++    if (repeated) score -= CONFIG.REPETITION_PENALTY;
++
++    score += (10 - (i % 10)) / 100;
++    return { reaction, score };
++  }).filter(x => x.score > 0).sort((a,b) => b.score - a.score);
++
++  const chosen = [];
++  const tagCounts = {};
++
++  for (const item of ranked) {
++    if (chosen.length >= CONFIG.MAX_BEATS) break;
++    const tag = item.reaction.tags[0] || "other";
++    if ((tagCounts[tag] || 0) >= 2) continue;
++    chosen.push(item);
++    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
++  }
++
++  let block =
++    "\n[WITNESS REACTIONS] Add only subtle fictional social/environmental reactions when they fit the established scene. " +
++    "Do not invent new violence, cruelty, motives, fear, guilt, ownership, or historical facts. " +
++    "Do not override {{char}} or force NPC behavior. Prefer silence, glances, spacing, routine, weather, " +
++    "institutional sounds, and aftermath over graphic description or procedural detail.\n";
++
++  let used = tokens(block);
++  const emitted = [];
++
++  for (const item of chosen) {
++    const line = "- " + item.reaction.line + ".\n";
++    if (used + tokens(line) > CONFIG.MAX_TOKENS) break;
++    block += line;
++    used += tokens(line);
++    emitted.push(item.reaction.id);
++  }
++
++  if (emitted.length) {
++    block +=
++      "Keep reactions uneven and human: a room can be tense without everyone reacting, and ordinary background activity can continue.\n";
++    context.character.scenario += block;
++  }
++
++  if (CONFIG.DEBUG) {
++    console.log(
++      "[Witness Reactions] activation=" + activation +
++      " tokens~" + tokens(block) +
++      " emitted=" + emitted.join(",")
++    );
++  }
++} else if (CONFIG.DEBUG) {
++  console.log("[Witness Reactions] inactive activation=" + activation);
++}
